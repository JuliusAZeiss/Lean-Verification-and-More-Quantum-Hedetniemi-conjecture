/-- Packed inverse coordinate lookup; correctness is proved below by kernel reduction. -/
def coordinateInverseData : ℕ := 

def coordinateInverse (n : ℕ) : ℕ :=
  coordinateInverseData / 2 ^ (10*n) % 1024

theorem coordinateInverse_left : ∀ v : Fin 788,
    coordinateInverse (baseCoordinate v).val = v.val := by decide

def neighborCandidate (u : Fin 788) (a : Fin 22) : Fin 788 :=
  Fin.ofNat' 788 (coordinateInverse ((baseCoordinate u).val ^^^ step a))

def sparseNeighborhood (u : Fin 788) : Finset (Fin 788) :=
  insert u (Finset.univ.image (neighborCandidate u))

theorem mem_sparseNeighborhood_of_adj {u v : Fin 788} (h : baseGraph.Adj u v) :
    v ∈ sparseNeighborhood u := by
  obtain ⟨a,ha⟩ := h
  have hcoord : (baseCoordinate v).val = (baseCoordinate u).val ^^^ step a := by
    rw [← ha, Nat.xor_cancel_left]
  have hinv : neighborCandidate u a = v := by
    apply Fin.ext
    change coordinateInverse ((baseCoordinate u).val ^^^ step a) % 788 = v.val
    rw [← hcoord,coordinateInverse_left,Nat.mod_eq_of_lt v.isLt]
  apply Finset.mem_insert_of_mem
  apply Finset.mem_image.mpr
  exact ⟨a,Finset.mem_univ _,hinv⟩

def weightedTermInt (u v : Fin 788) : ℤ :=
  (fiberSize u : ℤ) * (fiberSize v : ℤ) * integerWeight u * integerWeight v * sourceMatrixInt u v

theorem weighted_sum_sparse :
    (∑ u : Fin 788, ∑ v : Fin 788, weightedTermInt u v) =
      ∑ u : Fin 788, ∑ v ∈ sparseNeighborhood u, weightedTermInt u v := by
  apply Finset.sum_congr rfl
  intro u hu
  symm
  apply Finset.sum_subset (Finset.subset_univ _)
  intro v hv hnot
  have hne : u ≠ v := by
    intro heq
    subst v
    exact hnot (Finset.mem_insert_self _ _)
  have hnadj : ¬baseGraph.Adj u v := fun h => hnot (mem_sparseNeighborhood_of_adj h)
  simp only [weightedTermInt,sourceMatrixInt_support u v hne hnadj,mul_zero]

def weightedSparseRow (u : Fin 788) : ℤ :=
  ∑ v ∈ sparseNeighborhood u, weightedTermInt u v

