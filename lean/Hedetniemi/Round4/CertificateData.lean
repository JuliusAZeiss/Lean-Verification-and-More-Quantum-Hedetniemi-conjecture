def kernelData (a : Nat) : NatLookupTree :=
  match a with
  | 0 => kernelData0
  | 1 => kernelData1
  | 2 => kernelData2
  | _ => kernelData3

def blockData (a : Nat) : NatLookupTree :=
  match a with
  | 0 => blockData0
  | 1 => blockData1
  | 2 => blockData2
  | _ => blockData3

def factorData (a : Nat) : NatLookupTree :=
  match a with
  | 0 => factorData0
  | 1 => factorData1
  | 2 => factorData2
  | _ => factorData3

def unpackEntry (x j : Nat) : Int := Int.ofNat ((x / 2^(32*j)) % 4294967296) - 2147483648
def kernelEntryN (s i j : Nat) : Int := unpackEntry ((kernelData s).get i) j
def blockEntryN (a i j : Nat) : Int := unpackEntry ((blockData a).get i) j
def factorEntryN (a i j : Nat) : Int := if j ≤ i then unpackEntry ((factorData a).get i) j else 0
def residualEntryN (a i j : Nat) : Int :=
  1000000000000 * blockEntryN a i j -
    ((List.range 197).map (fun k => factorEntryN a i k * factorEntryN a j k)).sum
def rowCheck (a i : Nat) : Bool :=
  decide (0 ≤ residualEntryN a i i) &&
  decide (((List.range 197).map (fun j => |residualEntryN a i j|)).sum ≤
    2 * residualEntryN a i i)
def sourceMatrixInt (u v : Fin 788) : Int := kernelEntryN (Nat.xor (u.val % 4) (v.val % 4)) (u.val / 4) (v.val / 4)
def blockEntry (a : Fin 4) (i j : Fin 197) : Int := blockEntryN a.val i.val j.val
def kernelEntry (s : Fin 4) (i j : Fin 197) : Int := kernelEntryN s.val i.val j.val
def factorEntry (a : Fin 4) (i j : Fin 197) : Int := factorEntryN a.val i.val j.val

